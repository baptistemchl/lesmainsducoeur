# ===================================================================
# .htaccess — Les Mains du Cœur (o2switch / Apache + LiteSpeed)
# ===================================================================

# --- 1. Force HTTPS + redirige www → apex (lesmainsducoeur.com) ------
RewriteEngine On

# www → apex
RewriteCond %{HTTP_HOST} ^www\.lesmainsducoeur\.com$ [NC]
RewriteRule ^(.*)$ https://lesmainsducoeur.com/$1 [R=301,L]

# http → https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 2. SPA fallback : toute route inconnue → index.html -------------
# (utile si tu ajoutes plus tard react-router ; sans effet aujourd'hui)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|assets|images)/
RewriteRule ^ index.html [L]

# --- 3. Compression (gzip / brotli si dispo) -------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# --- 4. Cache navigateur ---------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML : pas de cache long (pour récupérer les nouvelles versions vite)
  ExpiresByType text/html                 "access plus 0 seconds"

  # Assets fingerprintés par Vite (hash dans le nom) : 1 an
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images : 30 jours
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/avif                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"

  # Manifest / robots / sitemap : 1 jour
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
  ExpiresByType application/xml           "access plus 1 day"
</IfModule>

# --- 5. Sécurité (en-têtes minimaux) ---------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# --- 6. Page d'erreur 404 → index.html (déjà géré par fallback SPA) --
ErrorDocument 404 /index.html
